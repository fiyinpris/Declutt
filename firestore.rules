rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // Sign-up can only create buyers or sellers; admins are assigned from the Firebase console.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role in ['buyer', 'seller']
        && request.resource.data.rewards == 0;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rewards']);
    }
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.sellerUid == request.auth.uid;
    }
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.sellerUid || 
        request.auth.uid == resource.data.buyerUid
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.sellerUid ||
        request.auth.uid == resource.data.buyerUid
      ) && (
        // Read receipts, and "delete for me" (you can only add yourself to deletedFor)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'delivered', 'deletedFor'])
          && request.resource.data.get('deletedFor', []).toSet()
               .difference(resource.data.get('deletedFor', []).toSet()).hasOnly([request.auth.uid])
          && request.resource.data.get('deletedFor', []).toSet().hasAll(resource.data.get('deletedFor', []))
        )
        // "Delete for everyone": only whoever sent the message
        || (
          ((resource.data.from == 'seller' && request.auth.uid == resource.data.sellerUid)
            || (resource.data.from == 'buyer' && request.auth.uid == resource.data.buyerUid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'replyTo', 'deletedForEveryone'])
          && request.resource.data.deletedForEveryone == true
        )
      );
    }
    match /notifications/{notificationId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.sellerUid;
      allow create: if request.auth != null
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.read == false;
      allow update: if request.auth != null && request.auth.uid == resource.data.sellerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
    match /savedItems/{savedId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
        && savedId.matches(request.auth.uid + '_.+')
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && savedId.matches(request.auth.uid + '_.+');
    }
    // Name + photo that other signed-in users see in chats (users/{uid} stays private)
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'photoURL'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && (request.resource.data.photoURL == null
          || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() < 900000));
    }
    // Contact page: anyone can send; only admins can read, mark read or delete
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'uid', 'read', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && ((request.auth == null && request.resource.data.uid == null)
          || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}