rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // Sign-up can only create buyers or sellers; admins are assigned from the Firebase console.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role in ['buyer', 'seller']
        && request.resource.data.rewards == 0;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rewards']);
    }
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // Same list as src/utils/categories.js
    function allowedCategory(d) {
      return d.category in ['Furniture', 'Appliances', 'Electronics'];
    }

    match /listings/{listingId} {
      allow read: if true;
      // Sellers' new listings start "pending" (an admin approves them) and can't be featured;
      // admins' own listings can go live directly.
      allow create: if request.auth != null && request.resource.data.sellerUid == request.auth.uid
        && allowedCategory(request.resource.data)
        && (isAdmin() || (
          request.resource.data.status == 'pending'
          && !request.resource.data.keys().hasAny(['featuredUntil', 'rejectReason'])
        ));
      // A category can't be changed to one that isn't allowed. Sellers can't approve their own
      // listings, feature them, or change the owner/review note; editing what buyers rely on
      // (name, description, photos, category) sends the listing back for review.
      allow update: if request.auth != null
        && (request.resource.data.category == resource.data.category
          || allowedCategory(request.resource.data))
        && ((
          resource.data.sellerUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['sellerUid', 'featuredUntil', 'rejectReason'])
          && (request.resource.data.get('status', 'approved') == resource.data.get('status', 'approved')
            || request.resource.data.status == 'pending')
          && (!request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['name', 'description', 'category', 'imageUrl', 'additionalImages'])
            || request.resource.data.status == 'pending')
        ) || isAdmin());
      allow delete: if request.auth != null
        && (resource.data.sellerUid == request.auth.uid || isAdmin());
    }
    // "Report this listing": signed-in users can file a report; only admins can see/handle them
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['listingId', 'listingName', 'sellerUid', 'reason', 'details', 'reporterUid', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 100
        && request.resource.data.details is string && request.resource.data.details.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.sellerUid || 
        request.auth.uid == resource.data.buyerUid
      );
      // you can only send as yourself (from == your side of the conversation)
      allow create: if request.auth != null && (
        (request.resource.data.from == 'buyer' && request.resource.data.buyerUid == request.auth.uid)
        || (request.resource.data.from == 'seller' && request.resource.data.sellerUid == request.auth.uid)
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.sellerUid ||
        request.auth.uid == resource.data.buyerUid
      ) && (
        // Read receipts, and "delete for me" (you can only add yourself to deletedFor)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'delivered', 'deletedFor'])
          && request.resource.data.get('deletedFor', []).toSet()
               .difference(resource.data.get('deletedFor', []).toSet()).hasOnly([request.auth.uid])
          && request.resource.data.get('deletedFor', []).toSet().hasAll(resource.data.get('deletedFor', []))
        )
        // "Delete for everyone": only whoever sent the message
        || (
          ((resource.data.from == 'seller' && request.auth.uid == resource.data.sellerUid)
            || (resource.data.from == 'buyer' && request.auth.uid == resource.data.buyerUid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'replyTo', 'deletedForEveryone'])
          && request.resource.data.deletedForEveryone == true
        )
      );
    }
    match /notifications/{notificationId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.sellerUid;
      allow create: if request.auth != null
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.read == false;
      allow update: if request.auth != null && request.auth.uid == resource.data.sellerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
    match /savedItems/{savedId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
        && savedId.matches(request.auth.uid + '_.+')
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && savedId.matches(request.auth.uid + '_.+');
    }
    // Each user's cart, so it survives sign-out and follows them across devices
    match /carts/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100;
    }
    // Name + photo that other signed-in users see in chats (users/{uid} stays private)
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'photoURL'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && (request.resource.data.photoURL == null
          || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() < 900000));
    }
    // Contact page: anyone can send; only admins can read, mark read or delete
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'uid', 'read', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && ((request.auth == null && request.resource.data.uid == null)
          || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}