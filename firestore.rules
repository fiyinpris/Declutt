rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // Sign-up can only create buyers or sellers; admins are assigned from the Firebase console.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role in ['buyer', 'seller']
        && request.resource.data.rewards == 0;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rewards']);
    }
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.sellerUid == request.auth.uid;
    }
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.sellerUid || 
        request.auth.uid == resource.data.buyerUid
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.sellerUid ||
        request.auth.uid == resource.data.buyerUid
      ) && (
        // Read receipts, and "delete for me" (you can only add yourself to deletedFor)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'delivered', 'deletedFor'])
          && request.resource.data.get('deletedFor', []).toSet()
               .difference(resource.data.get('deletedFor', []).toSet()).hasOnly([request.auth.uid])
          && request.resource.data.get('deletedFor', []).toSet().hasAll(resource.data.get('deletedFor', []))
        )
        // "Delete for everyone": only whoever sent the message
        || (
          ((resource.data.from == 'seller' && request.auth.uid == resource.data.sellerUid)
            || (resource.data.from == 'buyer' && request.auth.uid == resource.data.buyerUid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'replyTo', 'deletedForEveryone'])
          && request.resource.data.deletedForEveryone == true
        )
      );
    }
    match /notifications/{notificationId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.sellerUid;
      allow create: if request.auth != null
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.read == false;
      allow update: if request.auth != null && request.auth.uid == resource.data.sellerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
    match /savedItems/{savedId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
        && savedId.matches(request.auth.uid + '_.+')
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && savedId.matches(request.auth.uid + '_.+');
    }
  }
}