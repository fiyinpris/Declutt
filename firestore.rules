rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    // Admin = users/{uid}.role == 'admin' (set in the Firebase console) OR the site owner,
    // identified by the VERIFIED email in their signed Firebase Auth token (can't be faked by
    // the browser). Same owner address as src/utils/admin.js.
    function isOwner() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'fiyinolaleke@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }
    function isAdmin() {
      return isOwner() || (request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    // Suspended accounts (set by an admin) can't post listings or send messages
    function notSuspended() {
      return !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false);
    }
    // Same list as src/utils/categories.js
    function allowedCategory(d) {
      return d.category in ['Furniture', 'Appliances', 'Electronics'];
    }
    function isSender(d) {
      return (d.from == 'buyer' && d.buyerUid == request.auth.uid)
        || (d.from == 'seller' && d.sellerUid == request.auth.uid);
    }
    function inConversation(d) {
      return request.auth.uid == d.sellerUid || request.auth.uid == d.buyerUid;
    }

    // ── Accounts ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && request.auth.uid == userId;
      // Sign-up can only create buyers or sellers with zero rewards
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role in ['buyer', 'seller']
        && request.resource.data.rewards == 0
        && !request.resource.data.keys().hasAny(['suspended']);
      // Users edit their own profile but not role, rewards or suspension; admins manage accounts
      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rewards', 'suspended']))
        || isAdmin()
      );
    }

    // ── Listings ─────────────────────────────────────────────────────────────
    match /listings/{listingId} {
      allow read: if true;
      // Live immediately. Sellers can't pre-set moderation or featuring fields.
      allow create: if request.auth != null && request.resource.data.sellerUid == request.auth.uid
        && allowedCategory(request.resource.data)
        && (isAdmin() || (
          notSuspended()
          && !request.resource.data.keys().hasAny(['status', 'featuredUntil', 'rejectReason'])
        ));
      // A category can't be changed to one that isn't allowed. Sellers edit only their own
      // listings and can't touch the owner, moderation (status / note) or featuring.
      allow update: if request.auth != null
        && (request.resource.data.category == resource.data.category
          || allowedCategory(request.resource.data))
        && ((
          resource.data.sellerUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['sellerUid', 'featuredUntil', 'rejectReason', 'status'])
        ) || isAdmin());
      allow delete: if request.auth != null
        && (resource.data.sellerUid == request.auth.uid || isAdmin());
    }

    // ── Chat ─────────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if request.auth != null && (inConversation(resource.data) || isAdmin());
      // you can only send as yourself (from == your side of the conversation)
      allow create: if request.auth != null && isSender(request.resource.data) && notSuspended();
      allow update: if request.auth != null && (
        (inConversation(resource.data) && (
          // Read receipts, and "delete for me" (you can only add yourself to deletedFor)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'delivered', 'deletedFor'])
            && request.resource.data.get('deletedFor', []).toSet()
                 .difference(resource.data.get('deletedFor', []).toSet()).hasOnly([request.auth.uid])
            && request.resource.data.get('deletedFor', []).toSet().hasAll(resource.data.get('deletedFor', []))
          )
          // Reactions: each person only sets/removes their own
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions.diff(resource.data.get('reactions', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
          )
          // Edit: sender only, text only, not on deleted messages
          || (
            isSender(resource.data)
            && !resource.data.get('deletedForEveryone', false)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
          )
          // "Delete for everyone": sender only
          || (
            isSender(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'replyTo', 'deletedForEveryone'])
            && request.resource.data.deletedForEveryone == true
          )
        ))
        // Admins can moderate (e.g. remove an abusive message)
        || isAdmin()
      );
    }
    // "typing…" — doc id is buyerUid_sellerUid; only those two can read/write it
    match /typing/{convKey} {
      allow read, write: if request.auth != null && request.auth.uid in convKey.split('_');
    }

    // ── Alerts, saved items, carts, public profiles ──────────────────────────
    // Seller alerts (sellerUid) and buyer order updates (recipientUid). Browsers may only create
    // "saved" alerts; order alerts come from the Declutt server.
    match /notifications/{notificationId} {
      allow read, delete: if request.auth != null
        && (request.auth.uid == resource.data.sellerUid || request.auth.uid == resource.data.recipientUid);
      allow create: if request.auth != null
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.get('type', 'saved') == 'saved'
        && !('recipientUid' in request.resource.data);
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.sellerUid || request.auth.uid == resource.data.recipientUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
    match /savedItems/{savedId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
        && savedId.matches(request.auth.uid + '_.+')
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && savedId.matches(request.auth.uid + '_.+');
    }
    // Each user's cart, so it survives sign-out and follows them across devices
    match /carts/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100;
    }
    // Name + photo that other signed-in users see in chats (users/{uid} stays private)
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'photoURL'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && (request.resource.data.photoURL == null
          || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() < 900000));
    }

    // ── Reports, featured requests, support ─────────────────────────────────
    // "Report this listing" (product page) and "Report user" (chat); only admins see/handle them
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['type', 'listingId', 'listingName', 'sellerUid', 'reportedUid', 'reportedName', 'conversationKey', 'reason', 'details', 'reporterUid', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 100
        && request.resource.data.details is string && request.resource.data.details.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
    // "Request Featured Listing" from My Items
    match /featureRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['listingId', 'listingName', 'sellerUid', 'sellerName', 'sellerEmail', 'reason', 'status', 'createdAt'])
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read: if request.auth != null && (resource.data.sellerUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    // ── Checkout & payouts ───────────────────────────────────────────────────
    // Orders, checkouts and payouts are written ONLY by the Declutt server (/api with the
    // Firebase Admin SDK), which works out prices and fees and checks who may change what.
    // Browsers can only read their own.
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (resource.data.buyerUid == request.auth.uid
          || resource.data.sellerUid == request.auth.uid
          || isAdmin());
      allow write: if false;
    }
    match /checkouts/{checkoutId} {
      allow read: if request.auth != null
        && (resource.data.buyerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /payouts/{payoutId} {
      allow read: if request.auth != null
        && (resource.data.sellerUid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /payoutRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Payout bank accounts are added through the server (it checks the account with the bank).
    // An admin can only approve a name mismatch.
    match /sellerPayoutAccounts/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nameOverride'])
        && request.resource.data.nameOverride is bool;
      allow create, delete: if false;
    }
    // Fees & policies (settings/fees): everyone can read them (checkout shows them); admins edit
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact page: anyone can send; only admins can read, mark read or delete
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'uid', 'read', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && ((request.auth == null && request.resource.data.uid == null)
          || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}
